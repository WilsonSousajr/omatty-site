#!/usr/bin/env bash
# A scripted stand-in for `claude`, for the demo recording only. omatty starts
# it as `claude_bin`; everything around it - the cards, the gate, the verdicts,
# the diff - is the real omatty binary running the real gate. It never
# pretends to be Claude: its first line says what it is.
#
# It edits its worktree from patches/<branch>/<step>/ and reports turns the
# way claude does, through `omatty hook` (UserPromptSubmit, then Stop), which
# is what gate.auto listens for.
set -euo pipefail
session_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --session-id | --resume) session_id="$2"; shift 2 ;;
    *) shift ;;
  esac
done
branch=$(basename "$PWD")
patches="${DEMO_PATCHES:?DEMO_PATCHES is not set}/$branch"

# omatty sends gate failures as a bracketed paste; echoing it would print
# the escape bytes into the pane.
stty -echo 2>/dev/null || true

hook() { printf '{"session_id":"%s","hook_event_name":"%s"}' "$session_id" "$1" | omatty hook; }
say() { printf '%s\n' "$1"; sleep "${2:-0.6}"; }
dim() { printf '\033[2m%s\033[0m\n' "$1"; }
apply() { cp "$patches/$1"/* .; dim "  wrote $(cd "$patches/$1" && ls | tr '\n' ' ')"; }

# Wait for omatty to paste something in (the gate's failures), then drain it.
await_paste() {
  IFS= read -r _first
  # bash 3.2 (macOS /bin/bash) takes whole seconds only.
  while IFS= read -r -t 1 _rest; do :; done
}

turn() { # step, then the lines to say
  local step="$1"; shift
  hook UserPromptSubmit
  for line in "$@"; do say "$line"; done
  apply "$step"
  hook Stop
}

printf '\033[2J\033[H'
dim "stand-in agent, scripted for this demo"
echo

case "$branch" in
  round-to-cents)
    sleep 1.5
    say "task: Cents(0.29) returns 28; round to the nearest cent" 1
    turn 1 "0.29 * 100 is 28.999999999999996, and int64() truncates it" \
      "rounding with math.Round, and adding a test for 0.29"
    ;;
  quoted-fields)
    sleep 3
    say "task: a comma inside double quotes belongs to the field" 1
    turn 1 "tracking whether the scanner is inside quotes" \
      "adding a test for a,\"b,c\",d"
    await_paste
    say "gate: TestFieldsQuotedComma failed" 0.8
    dim '  Fields = ["a" "\"b,c\"" "d"], want ["a" "b,c" "d"]'
    turn 2 "the quotes stay in the field" "trimming them in unquote()"
    ;;
esac
# Stay alive like an idle session until omatty ends it.
while IFS= read -r _; do :; done
