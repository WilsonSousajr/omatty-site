[1.1565, "o", "\u001b[?25l\u001b[0 q\n\u001b[38;5;174m \u2590\u001b[48;5;16m\u259b\u2588\u2588\u2588\u259b\u2588\u001b[m   \u001b[1mClaude Code\u001b[m \u001b[38;5;246mv2.1.283\u001b[m\u001b[5;30H\u001b[38;5;174m\u259d\u259c\u001b[48;5;16m\u2588\u2588\u2588\u2588\u2588\u001b[49m\u2588\u2580\u001b[m  \u001b[38;5;246mSonnet 5 \u00b7 Claude API\u001b[m\u001b[6;30H\u001b[38;5;174m \u259d\u259d   \u259d\u259d \u001b[m  \u001b[38;5;246m/private/tmp/omd/.omatty/wt/ledger/round-to-cents\u001b[m\u001b[8;30H\u001b[38;5;174m\u258e\u001b[m \u001b[1mAuto mode is now Claude Code's default permission mode.\u001b[m\u001b[9;30H\u001b[38;5;174m\u258e\u001b[m \u001b[38;5;246mAuto mode lets Claude handle permission prompts automatically. Claude checks each tool \u001b[m\u001b[10;30H\u001b[38;5;174m\u258e\u001b[m \u001b[38;5;246mcall for risky actions and prompt injection before executing, runs the ones it assesses \u001b[m\u001b[11;30H\u001b[38;5;174m\u258e\u001b[m \u001b[38;5;246mas lower-risk, and blocks the rest.\u001b[m\u001b[12;30H\u001b[38;5;174m\u258e\u001b[m \u001b[38;5;246mhttps://code.claude.com/docs/en/permission-modes\u001b[m\u001b[13;32H\u001b[38;5;246m1 more notice hidden\u001b[m\u001b[25;103H\u001b[38;5;246m\u25cf high \u00b7 /effort\u001b[m\u001b[26;30H\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m"]
