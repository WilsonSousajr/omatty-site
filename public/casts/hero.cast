[24.4708, "o", "\u001b[6;21r\u001b[21;1H\u001b[2S\u001b[1;30r\u001b[1;57H\u001b[38;5;250m\u2819\u001b[m \u001b[3;30H\u001b[32X\n\u001b[3G\u001b[38;5;250m\u2819\u001b[m \u001b[38;5;253;1mround to cents    \u001b[m \u001b[38;5;245m <1m\u001b[m \u001b[38;5;238m\u2502\u001b[38;5;174m\u258e\u001b[m \u001b[1mAuto mode is now Claude Code's default permission \u001b[m\u001b[5;30H\u001b[38;5;174m\u258e\u001b[m \u001b[1mmode.\u001b[m\r\n\u001b[38;5;75m\u258e\u001b[m   \u2713\u2713\u2713\u001b[21X\u001b[6;29H\u001b[38;5;238m\u2502\u001b[38;5;174m\u258e\u001b[m \u001b[38;5;246mAuto mode lets Claude handle permission prompts \u001b[m     \u001b[38;5;75m\u2502\u001b[m    money.go\r\n  \u001b[38;5;245m\u25be parser\u001b[18X\u001b[7;29H\u001b[38;5;238m\u2502\u001b[38;5;174m\u258e\u001b[m \u001b[38;5;246mautomatically. Claude checks each tool call for risky\u001b[38;5;75m\u2502\u001b[m    money_test.go\r\n  \u001b[38;5;250m\u2819\u001b[m \u001b[38;5;250mquoted fields     \u001b[m \u001b[38;5;245m <1m\u001b[m\n\u001b[5Gquoted-fields\n\u001b[5G\u2713\u2713\u2713 \u001b[20;29H\u001b[38;5;238m\u2502\u001b[38;5;246m  \u23bf  money_test.\u001b[m\u001b[39X\u001b[20;85H\u001b[38;5;75m\u2502\u001b[m\u001b[21;29H\u001b[38;5;238m\u2502\u001b[38;5;246m\u23fa\u001b[m Reading money_test.go\u001b[32X\u001b[21;85H\u001b[38;5;75m\u2502\u001b[m"]
