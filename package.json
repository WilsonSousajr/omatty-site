{
  "name": "omatty-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gate:format": "prettier --check .",
    "gate:lint": "eslint . --max-warnings 0",
    "gate:types": "next typegen && tsc --noEmit",
    "gate:deps": "knip",
    "gate:vuln": "npm audit --omit=dev --audit-level=high",
    "gate:boundaries": "depcruise --config .dependency-cruiser.cjs .",
    "gate:dupl": "jscpd",
    "gate:test": "vitest run --coverage",
    "gate:build": "next build",
    "gate:smoke": "playwright test",
    "gate:budget": "lhci autorun",
    "test": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-sonarjs": "4.2.1",
    "jscpd": "5.3.2",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "24.21.0"
  }
}
